## StangaNetLib.Storage — line endings, diffs, and export rules
## Working tree and GitHub: LF. Matches .editorconfig end_of_line = lf.

* text=auto eol=lf

*.cs          text diff=csharp
*.csproj      text
*.props       text
*.targets     text
*.sln         text
*.json        text
*.yml         text
*.yaml        text
*.md          text
*.txt         text
*.xml         text
*.config      text
.editorconfig text
.gitattributes text
.gitignore    text

*.sh          text eol=lf
*.ps1         text eol=lf
*.cmd         text eol=crlf
*.bat         text eol=crlf

*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.dll   binary
*.exe   binary
*.pdb   binary
*.nupkg binary
*.snupkg binary
*.snk   binary
*.pfx   binary
*.zip   binary
*.7z    binary
*.gz    binary

*.cs linguist-language=C#
docs/** linguist-documentation
*.md linguist-documentation

.gitattributes  export-ignore
.gitignore      export-ignore
.github/        export-ignore
.editorconfig   export-ignore
graphify-out/   export-ignore
artifacts/      export-ignore
TestResults/    export-ignore

assets/** linguist-vendored
